# Clerk (clerk-jwt-auth-inbound policy)
CLERK_FRONTEND_API_URL=

# Session API key bucket — same value as teiwah-control ZUPLO_KEY_BUCKET
# (Zuplo portal forbids env names starting with ZUPLO_)
TEIWAH_KEY_BUCKET=

# Control app (routes: /sessions, webhook, api-key)
# Local: CONTROL_URL=http://localhost:4007
# Prod:  CONTROL_URL=https://control.teiwah.cloud
CONTROL_URL=

# k3s Traefik ingress — session SSE + outbound messages (routes: /events, /messages)
# Local + prod today: INGRESS_URL=https://k3s.teiwah.cloud
# Local k3d later:     INGRESS_URL=http://localhost:8080
INGRESS_URL=
