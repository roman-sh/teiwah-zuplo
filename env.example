# Clerk (clerk-jwt-auth-inbound policy)
CLERK_FRONTEND_API_URL=

# Session API key bucket — same value as teiwah-control ZUPLO_KEY_BUCKET
# (Zuplo portal forbids env names starting with ZUPLO_)
TEIWAH_KEY_BUCKET=

# Control app (routes: /sessions, webhook, api-key)
# Local: CONTROL_URL=http://localhost:4007
# Prod:  CONTROL_URL=https://control.teiwah.cloud
CONTROL_URL=

# k3s Traefik ingress — session SSE + outbound messages (routes: /events, /messages)
# Local + prod today: INGRESS_URL=https://k3s.teiwah.cloud
# Local k3d later:     INGRESS_URL=http://localhost:8080
INGRESS_URL=

# R2 — outbound base64 media normalization (POST /messages, API.md §6.2).
# Zuplo uploads decoded base64 to R2 (S3 API + SigV4) and rewrites to media.url.
# No trailing slash on R2_PUBLIC_BASE_URL or R2_S3_ENDPOINT.
# Public read base (custom domain or *.r2.dev):
R2_PUBLIC_BASE_URL=
# S3 endpoint INCLUDING the bucket name: https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_S3_ENDPOINT=
# R2 API token credentials (Object Read & Write, scoped to the bucket):
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
