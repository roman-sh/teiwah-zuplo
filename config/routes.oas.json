    },
    "/sessions/{id}/webhook": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "patch": {
        "summary": "Update session webhook URL",
        "operationId": "update-session-webhook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/sessions/{id}/api-key": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Reveal session API key",
        "operationId": "get-session-api-key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/messages": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Send WhatsApp message (session API key)",
        "operationId": "post-session-message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["chatId"],
                "properties": {
                  "chatId": {
                    "type": "string",
                    "description": "Reply address: bare phone number or full JID/LID (use the inbound webhook `chatId`)"
                  },
                  "text": {
                    "type": "string",
                    "description": "Message text. Provide either `text` or `media` (exactly one)."
                  },
                  "media": {
                    "type": "object",
                    "description": "Media to send. Supply either `url` or `base64` (base64 is normalized to a temporary URL by the gateway before reaching the worker).",
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["image", "ptt", "audio", "video", "document"]
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Publicly fetchable media URL."
                      },
                      "base64": {
                        "type": "string",
                        "description": "Base64-encoded media bytes (max 16 MB decoded; larger → 413). Normalized to a URL by the gateway; the worker only ever receives a URL."
                      },
                      "caption": { "type": "string" },
                      "mimeType": { "type": "string" },
                      "filename": { "type": "string" }
                    }
                  },
                  "quoteMessageId": {
                    "type": "string",
                    "description": "Native id of a message to reply-quote (best-effort)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message sent" },
          "401": { "description": "Invalid or missing API key" },
          "413": { "description": "media.base64 exceeds the 16 MB decoded limit" },
          "503": { "description": "Session not connected" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.INGRESS_URL}"
            }
          },
          "policies": {
            "inbound": [
              "session-api-key-inbound",
              "outbound-media-base2url",
              "patch-session-from-bearer"
            ]
          }
        }
      }
    },
    "/typing": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Show typing indicator in a chat (session API key)",
        "operationId": "post-session-typing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["chatId"],
                "properties": {
                  "chatId": {
                    "type": "string",
                    "description": "Conversation address (use the inbound webhook `chatId`)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Typing indicator sent" },
          "401": { "description": "Invalid or missing API key" },
          "503": { "description": "Session not connected" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.INGRESS_URL}"
            }
          },
          "policies": {
            "inbound": ["session-api-key-inbound", "patch-session-from-bearer"]
          }
        }
      }
    },
    "/read": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Mark an inbound message as read (session API key)",
        "operationId": "post-session-read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messageId"],
                "properties": {
                  "messageId": {
                    "type": "string",
                    "description": "Native WhatsApp message id from the inbound webhook"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message marked read" },
          "401": { "description": "Invalid or missing API key" },
          "404": { "description": "Unknown messageId (not in recent cache)" },
          "503": { "description": "Session not connected" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.INGRESS_URL}"
            }
          },
          "policies": {
            "inbound": ["session-api-key-inbound", "patch-session-from-bearer"]
          }
        }
      }
    },
    "/media/{id}": {
