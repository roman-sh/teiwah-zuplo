  "paths": {
    "/sessions": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Get user's WA sessions",
        "operationId": "get-sessions",
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      },
      "post": {
        "summary": "Create WA session",
        "operationId": "create-session",
        "responses": {
          "201": { "description": "Created" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
