        ],
        "responses": {
          "200": { "description": "Media bytes (streamed; original Content-Type)" },
          "401": { "description": "Invalid or missing API key" },
          "404": { "description": "Media not found or expired" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
