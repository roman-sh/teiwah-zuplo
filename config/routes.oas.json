{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Teiwah API"
  },
  "paths": {
    "/sessions": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Get user's WA sessions",
        "operationId": "get-sessions",
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      },
      "post": {
        "summary": "Create WA session",
        "operationId": "create-session",
        "responses": {
          "201": { "description": "Created" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/billing/checkout": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Create license-scoped Freemius checkout (Subscribe/upgrade)",
        "operationId": "create-billing-checkout",
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/billing/sandbox": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Get Freemius sandbox params for the new-purchase overlay (dev only)",
        "operationId": "get-billing-sandbox",
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/sessions/{id}/webhook": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "patch": {
        "summary": "Update session webhook URL",
        "operationId": "update-session-webhook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/sessions/{id}/api-key": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Reveal session API key",
        "operationId": "get-session-api-key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.CONTROL_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound",
              "forward-user-id"
            ]
          }
        }
      }
    },
    "/messages": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Send WhatsApp message (session API key)",
        "operationId": "post-session-message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to", "text"],
                "properties": {
                  "to": {
                    "type": "string",
                    "description": "Recipient JID (use inbound webhook `from` for 1:1 replies)"
                  },
                  "text": {
                    "type": "string",
                    "description": "Message text"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message sent" },
          "401": { "description": "Invalid or missing API key" },
          "503": { "description": "Session not connected" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/messages-forward)"
          },
          "policies": {
            "inbound": ["session-api-key-inbound"]
          }
        }
      }
    },
    "/media/{id}": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Download inbound media by message id (session API key)",
        "operationId": "get-media",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Native WhatsApp message id from the inbound webhook"
          }
        ],
        "responses": {
          "200": { "description": "Media bytes (streamed; original Content-Type)" },
          "401": { "description": "Invalid or missing API key" },
          "404": { "description": "Media not found or expired" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "default",
            "module": "$import(./modules/media-forward)"
          },
          "policies": {
            "inbound": ["session-api-key-inbound"]
          }
        }
      }
    },
    "/sessions/{id}/events": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Session SSE stream (QR, status)",
        "operationId": "get-session-events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "SSE stream" }
        },
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.INGRESS_URL}"
            }
          },
          "policies": {
            "inbound": [
              "clerk-jwt-auth-inbound"
            ]
          }
        }
      }
    }
  }
}
