{
  "policies": [
    {
      "handler": {
        "export": "ClerkJwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "frontendApiUrl": "$env(CLERK_FRONTEND_API_URL)",
          "oAuthResourceMetadataEnabled": false
        }
      },
      "name": "clerk-jwt-auth-inbound",
      "policyType": "clerk-jwt-auth-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/forward-user-id)",
        "options": {}
      },
      "name": "forward-user-id",
      "policyType": "custom-code-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/outbound-media-base2url)",
        "options": {}
      },
      "name": "outbound-media-base2url",
      "policyType": "custom-code-inbound"
    },
    {
      "handler": {
        "export": "ApiKeyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "authHeader": "Authorization",
          "authScheme": "Bearer",
          "bucketName": "$env(TEIWAH_KEY_BUCKET)",
          "cacheTtlSeconds": 60
        }
      },
      "name": "session-api-key-inbound",
      "policyType": "api-key-inbound"
    }
  ]
}